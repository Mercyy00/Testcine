# TMDB (server-only) https://www.themoviedb.org/settings/api
TMDB_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_INVITE=

# Supabase Postgres (Project Settings > Database > Connection string)
DATABASE_URL=          # Transaction pooler, port 6543, add ?pgbouncer=true
DIRECT_URL=            # Direct connection, port 5432

# NextAuth (openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Global serverless rate limiting (required in production)
# Create a Redis database at Upstash and copy its REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional social login (also set the NEXT_PUBLIC_*_ENABLED=1 flag to show the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_ENABLED=

# Watch party realtime (Phase 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
