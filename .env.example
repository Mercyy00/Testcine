# Add these to .env.local. Only configured nodes appear in the player.
# Use HTTPS CDN origins; an optional base path is supported.
STREAM_BOREAS_ORIGIN=
STREAM_KRATOS_ORIGIN=
STREAM_ZEUS_ORIGIN=
STREAM_DEFAULT_SERVER=boreas
# Optional administrative status: online or offline (not a health probe).
STREAM_BOREAS_STATUS=online
STREAM_KRATOS_STATUS=online
STREAM_ZEUS_STATUS=online
